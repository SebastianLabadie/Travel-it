---
interface Props {
  active: 'home' | 'itinerario' | 'checklist' | 'reservas';
}

const { active } = Astro.props;

const tabs = [
  { id: 'home',       label: 'HOME',       num: '01', href: '/'           },
  { id: 'itinerario', label: 'ITINERARIO', num: '02', href: '/itinerario' },
  { id: 'checklist',  label: 'CHECKLIST',  num: '03', href: '/checklist'  },
  { id: 'reservas',   label: 'RESERVAS',   num: '04', href: '/reservas'   },
] as const;
---

<nav class="tab-bar" aria-label="Navegación principal">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      aria-current={active === tab.id ? 'page' : undefined}
      class:list={['tab-bar__item', { 'tab-bar__item--active': active === tab.id }]}
    >
      <span class="tab-bar__num">{tab.id === 'reservas' ? '▢' : tab.num}</span>
      <span class="tab-bar__label">{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .tab-bar {
    display: flex; /* visible on mobile */
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule);
    z-index: 900;
  }

  @media (min-width: 1024px) {
    .tab-bar {
      display: none; /* hidden on desktop */
    }
  }

  .tab-bar__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    text-decoration: none;
    color: var(--color-stone);
    position: relative;
    padding-top: 6px;
  }

  .tab-bar__item:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: -2px;
  }

  .tab-bar__item--active {
    color: var(--color-fg);
  }

  /* 2px top indicator for active tab */
  .tab-bar__item--active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: var(--color-fg);
  }

  .tab-bar__num {
    font-family: var(--font-mono);
    font-size: 0.5625rem; /* 9px */
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }

  .tab-bar__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }
</style>
