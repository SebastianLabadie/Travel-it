---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ItineraryView } from '../components/itinerary/ItineraryView';
import { getDestinations, getDays } from '../lib/trip';

const destinations = await getDestinations();
const days = await getDays();
---

<BaseLayout title="Patagonia · Itinerario" activeTab="itinerario">
  <ItineraryView
    client:visible
    destinations={destinations}
    days={days}
  />
</BaseLayout>

<style>
  /*
   * Responsive layout switching for ItineraryView.
   * .itin-mobile  — shown below 1024px (mobile + tablet)
   * .itin-desktop — shown at 1024px+ (desktop 3-col grid)
   *
   * The island always renders both; CSS controls visibility.
   * This avoids hydration mismatch when JS runs after SSG.
   */

  :global(.itin-mobile) {
    display: block;
  }
  :global(.itin-desktop) {
    display: none;
  }

  @media (min-width: 1024px) {
    :global(.itin-header) {
      padding: 24px 32px 16px;
      border-bottom: 1px solid var(--color-rule);
    }
    :global(.itin-mobile) {
      display: none;
    }
    :global(.itin-desktop) {
      display: flex;
      flex: 1;
      height: calc(100vh - 73px - 96px); /* viewport - topnav - header */
      overflow: hidden;
    }
  }
</style>
